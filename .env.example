# Database — SQLite by default (zero-setup local dev)
# To use PostgreSQL: change provider in prisma/schema.prisma to "postgresql"
# and update DATABASE_URL accordingly
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codeforge?schema=public"

# Redis (optional for local dev — app works without it)
REDIS_URL="redis://localhost:6379"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-change-in-production"

# GitHub OAuth (optional — email/password auth works without these)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Sandbox
SANDBOX_TIMEOUT_MS=10000
SANDBOX_MEMORY_LIMIT_MB=256
SANDBOX_DOCKER_SOCKET="/var/run/docker.sock"
